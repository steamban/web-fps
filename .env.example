# Copy to .env to override. Every value here is the default baked into
# packages/server/src/config.ts — the file exists to document the knobs.

SERVER_PORT=8080
TICK_RATE_HZ=20
MIN_PLAYERS=2
MAX_PLAYERS=8
KILL_LIMIT=30
TIME_LIMIT_MINUTES=10
RESPAWN_SECONDS=5
SPAWN_PROTECTION_SECONDS=5

# dev    - debug HUD, verbose logging, host may start solo
# player - the normal LAN-party experience
GAME_MODE=player
